<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact | CTS Group</title>
    <link rel="stylesheet" href="styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;500;700&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="nav-future">
        <div class="nav-container">
            <div class="logo-glow">
                <span class="logo-text">CTS</span>
                <span class="logo-sub">GROUP</span>
            </div>
            <ul class="nav-links">
                <li><a href="index.html" class="nav-link">Home</a></li>
                <li><a href="about.html" class="nav-link">About</a></li>
                <li><a href="projects.html" class="nav-link">Projects</a></li>
                <li><a href="contact.html" class="nav-link active btn-glow">Contact</a></li>
            </ul>
            <div class="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </nav>

    <section class="page-hero contact-hero">
        <div class="page-hero-content">
            <h1>Get in <span class="highlight">Touch</span></h1>
            <p>Ready to build the future together?</p>
        </div>
    </section>

    <section class="contact-section">
        <div class="container">
            <div class="contact-grid">
                <div class="contact-info-panel">
                    <div class="location-card">
                        <div class="location-header">
                            <span class="location-icon">📍</span>
                            <h3>Waterford Office</h3>
                        </div>
                        <p>[Your Waterford Address]</p>
                        <p>Phone: [Your Number]</p>
                        <p>Email: waterford@ctsgroup.ie</p>
                    </div>
                    <div class="location-card">
                        <div class="location-header">
                            <span class="location-icon">📍</span>
                            <h3>Dublin Office</h3>
                        </div>
                        <p>[Your Dublin Address]</p>
                        <p>Phone: [Your Number]</p>
                        <p>Email: dublin@ctsgroup.ie</p>
                    </div>
                    <div class="social-links">
                        <a href="#" class="social-btn">LinkedIn</a>
                        <a href="#" class="social-btn">Twitter</a>
                    </div>
                </div>
                
                <div class="contact-form-panel">
                    <form class="futuristic-form">
                        <div class="form-group">
                            <input type="text" required>
                            <label>Name</label>
                            <div class="input-line"></div>
                        </div>
                        <div class="form-group">
                            <input type="email" required>
                            <label>Email</label>
                            <div class="input-line"></div>
                        </div>
                        <div class="form-group">
                            <input type="text" required>
                            <label>Company</label>
                            <div class="input-line"></div>
                        </div>
                        <div class="form-group">
                            <textarea required></textarea>
                            <label>Message</label>
                            <div class="input-line"></div>
                        </div>
                        <button type="submit" class="btn-primary btn-full">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <footer class="footer-future">
        <div class="container">
            <div class="footer-content">
                <div class="footer-logo">CTS GROUP</div>
                <div class="footer-links">
                    <a href="index.html">Home</a>
                    <a href="about.html">About</a>
                    <a href="projects.html">Projects</a>
                    <a href="contact.html">Contact</a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 CTS Group. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="script.js"></script>
</body>
</html>
